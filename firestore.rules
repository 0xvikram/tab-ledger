rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each shop (an anonymous Firebase user) sees only its own ledger.
    match /shops/{uid}/entries/{entryId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid && validEntry(request.resource.data);
    }
    match /{document=**} {
      allow read, write: if false;
    }

    function validEntry(d) {
      return d.keys().hasOnly(['customer', 'kind', 'amount', 'items', 'said', 'source', 'at'])
        && d.customer is string && d.customer.size() > 0 && d.customer.size() <= 80
        && d.kind in ['credit', 'payment']
        && d.amount is int && d.amount > 0 && d.amount <= 1000000000
        && d.items is string && d.items.size() <= 300
        && d.said is string && d.said.size() <= 500
        && d.source in ['on_device', 'in_cloud', 'typed']
        && d.at is int;
    }
  }
}
